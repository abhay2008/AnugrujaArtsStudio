# ── AI Chat Assistant (Chitra) ──────────────────────────────────────────────
# Server-only. Never expose these to the browser.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free-tier models, lite & fast. The first is primary; the rest are tried in
# order if the primary errors or is rate-limited. Free-model availability
# rotates, so check https://openrouter.ai/models?max_price=0 occasionally.
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_FALLBACK_MODELS=nex-agi/nex-n2.5-mini:free

# Public site URL — sent to OpenRouter as the HTTP-Referer attribution header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin portal (existing) ────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── GitHub CMS persistence (existing) ──────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=abhay2008
GITHUB_REPO=AnugrujaArtsStudio
GITHUB_BRANCH=main
