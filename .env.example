# Copy this file to .env.local for local development (that file is git-ignored).
# NEVER put real values in this template or anywhere else in the repository.
#
# Production values live in the host's environment settings
# (Vercel → Project → Settings → Environment Variables).

# Admin console password. Required — the app fails closed without it, so no
# built-in/default password ever ships in the code. Compared as a SHA-256 hash
# with a timing-safe equality check; signs a 1-hour HMAC session cookie.
ADMIN_PASSWORD=

# Git-backed CMS. Without these the console still saves content/site.json
# locally, but cannot push uploads or content commits to GitHub.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
